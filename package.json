{
  "name": "juune-university-operations-accountability-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "test:unit": "npm run test:unit --workspace backend && npm run test:unit --workspace frontend",
    "test:db": "npm run test:db --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "lint": "eslint backend frontend eslint.config.js",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:db && npm run test:integration && npm run build"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
