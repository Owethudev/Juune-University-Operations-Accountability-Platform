{
  "name": "@juune/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/server.ts",
    "test:unit": "vitest run tests/unit",
    "test:db": "node --env-file-if-exists=../.env ../node_modules/vitest/vitest.mjs run tests/database",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
